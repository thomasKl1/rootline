# Copie ce fichier en .env.local et remplis avec les valeurs de TON projet Supabase
# (Project Settings > API). Ces deux valeurs sont publiques : la sécurité repose
# sur la connexion et les règles d'accès (RLS) de la base, pas sur ce fichier.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
